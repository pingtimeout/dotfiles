#!/usr/bin/env bash
# vim: foldmethod=marker

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# {{{ Disable Homebrew and APT confirmations for batch installs
export HOMEBREW_NO_ASK=1
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1
export DEBIAN_FRONTEND=noninteractive
# }}}

# {{{ Init submodules as some are required dotbot plugins
git -C "${BASEDIR}" submodule update --init --recursive
# }}}

# {{{ Install Homebrew
if command -v brew >/dev/null 2>&1; then
  echo "Homebrew is already installed, nothing to do"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
# }}}

# {{{ Linuxify MacOS but stay on the current shell with the "N" answer
cd "${BASEDIR}/linuxify"
./linuxify install <<<"N"
cd "${BASEDIR}"
# }}}

# {{{ Install oh-my-zsh
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
if [ -d "$HOME/.oh-my-zsh/" ]; then
  echo "Oh-my-zsh is already installed, nothing to do"
else
  (
    cd /tmp/
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh -o install.sh
    chmod +x install.sh
    ./install.sh --unattended
    rm -f ./install.sh
  )
fi
# }}}

# {{{ Create ~/.config
mkdir -p ~/.config
# }}}

# {{{ Delegate the rest to dotbot but exclude asdf at is is not yet installed
echo First dotbot run...
"${BASEDIR}/install" --except asdf
# }}}

# {{{ Now invoke dotbot again only for asdf in a new shell to reload the path
echo Second dotbot run...
zsh -c "'${BASEDIR}/install' --only asdf"
# }}}

# {{{ Change OSX settings, although not sure whether this still does much
# Stolen form https://github.com/skwp/dotfiles/blob/master/osx

# Expand save panel by default
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true

# Enable full keyboard access for all controls (e.g. enable Tab in modal dialogs)
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

# Enable subpixel font rendering on non-Apple LCDs
defaults write NSGlobalDomain AppleFontSmoothing -int 2

# Automatically open a new Finder window when a volume is mounted
defaults write com.apple.frameworks.diskimages auto-open-ro-root -bool true
defaults write com.apple.frameworks.diskimages auto-open-rw-root -bool true
defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true

# Disable press-and-hold for keys in favor of key repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Set a blazingly fast keyboard repeat rate
defaults write NSGlobalDomain KeyRepeat -int 0

# Show status bar in Finder
defaults write com.apple.finder ShowStatusBar -bool true

# Avoid creating .DS_Store files on network volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

# Enable snap-to-grid for desktop icons
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist

# Only use UTF-8 in Terminal.app
defaults write com.apple.terminal StringEncodings -array 4

# Kill affected applications
for app in Finder Dock Mail Safari iTunes iCal Address\ Book SystemUIServer; do killall "$app" >/dev/null 2>&1; done
echo "OSX Hacks Done. Note that some of these changes require a logout/restart to take effect."
# }}}

# {{{ Enable MacOS window management keyboard shortcuts
set_hotkey() {
  # The modifier value 1966080 represents Shift+Control+Option+Command (the “Hyper” combination)
  # Use  https://github.com/feedthejim/hyperkey to remap caps lock to hyper
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
    "<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>$2</integer><integer>$3</integer><integer>1966080</integer></array><key>type</key><string>standard</string></dict></dict>"
}

# The numeric IDs correspond to macOS window-tiling actions (see https://gist.github.com/stephancasas/2c8e8f71e23ec7221495d7f4b9efb794)
set_hotkey 237 102 3
set_hotkey 240 104 4
set_hotkey 241 108 37
set_hotkey 242 107 40
set_hotkey 243 106 38
set_hotkey 244 119 13
set_hotkey 245 101 14
set_hotkey 246 115 1
set_hotkey 247 100 2

# Reload settings
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u
# }}}
